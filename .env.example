# Copy this file to `.env` and fill in the real value:
#
#     cp .env.example .env
#
# `.env` is git-ignored; this template is committed. The point of the split is
# that the repository documents which variables exist without ever containing a
# credential. Anyone cloning can see what they need to set; nobody inherits a key.
#
# Never add a real key to THIS file. It is the one that gets committed.

# Free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ────────────────────────────────────────────────────────────────
# The sandbox root: the ONLY directory the file tools may read or write.
# Defaults to the project directory when unset, which is what you want for local
# use. Point it at a dedicated scratch directory if you plan to feed the assistant
# documents from an untrusted source — the smaller the blast radius, the less any
# single prompt injection can reach. See the security section of the README.
#
# ASSISTANT_ROOT=/absolute/path/to/a/scratch/directory
